{
  "id": "64d00de7-2ead-42e9-8c63-16c82e3611ab",
  "name": "@syncpoint/signal",
  "version": "1.2.0",
  "type": "module",
  "description": "Algebraic type for time varying values",
  "files": [
    "dist"
  ],
  "main": "./dist/signal.umd.cjs",
  "module": "./dist/signal.es.js",
  "exports": {
    ".": {
      "require": "./dist/signal.umd.cjs",
      "import": "./dist/signal.es.js",
      "default": "./dist/signal.umd.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/syncpoint/signal.git"
  },
  "scripts": {
    "test": "mocha './test/**/*.test.js'",
    "prepare": "vite build",
    "coverage": "c8 -all --include 'lib/**/*' --reporter=html mocha './test/**/*.test.js'"
  },
  "keywords": [
    "frp",
    "signal",
    "stream",
    "functional",
    "algebraic",
    "type",
    "time-varying"
  ],
  "author": "horst.dehmer@syncpoint.io",
  "license": "MIT",
  "devDependencies": {
    "c8": "^10.1.2",
    "micro-bmark": "^0.3.1",
    "mocha": "^10.6.0",
    "ramda": "^0.30.1",
    "signal-polyfill": "github:dehmer/signal-polyfill",
    "vite": "^5.3.3"
  }
}
